<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Sunset gradient base — large, fills 80% of adaptive icon, premium warm gradient -->
    <path
        android:pathData="M14,14h80a16,16 0 0 1 16,16v80a16,16 0 0 1 -16,16h-80a16,16 0 0 1 -16,-16v-80a16,16 0 0 1 16,-16z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="10"
                android:startY="8"
                android:endX="100"
                android:endY="102"
                android:tileMode="clamp">
                <item android:offset="0.0" android:color="#FF9A00"/>
                <item android:offset="0.18" android:color="#FFB81C"/>
                <item android:offset="0.38" android:color="#FF8C32"/>
                <item android:offset="0.62" android:color="#FF4D6A"/>
                <item android:offset="0.85" android:color="#E9408A"/>
                <item android:offset="1.0" android:color="#C83C8A"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle top highlight for depth — makes gradient feel lit -->
    <path
        android:pathData="M14,14h80a16,16 0 0 1 16,16v10a16,16 0 0 0 -16,-16h-80a16,16 0 0 0 -16,16v-10a16,16 0 0 1 16,-16z"
        android:fillColor="#40FFFFFF"/>

    <!-- Bottom vignette for premium contrast and black integration -->
    <path
        android:pathData="M14,98a16,16 0 0 0 16,16h80a16,16 0 0 0 16,-16v-14a16,16 0 0 1 -16,16h-80a16,16 0 0 1 -16,-16z"
        android:fillColor="#30000000"/>

    <!-- Central symbol: Bold, rounded check mark — represents 'Cheak' (check), large and intentional -->
    <!-- Shadow for check for depth -->
    <path
        android:pathData="M33,58L49,74L79,40"
        android:fillColor="#00000000"
        android:strokeColor="#000000"
        android:strokeWidth="9.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeAlpha="0.22"/>

    <!-- Main white check — thick, rounded, confident -->
    <path
        android:pathData="M32,56L48,72L78,38"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="8.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>

    <!-- Icy accent: small diamond / sparkle at top — represents 'Icy', premium detail -->
    <path
        android:pathData="M76,22L78,26L82,28L78,30L76,34L74,30L70,28L74,26Z"
        android:fillColor="#FFFFFF"/>

</vector>
