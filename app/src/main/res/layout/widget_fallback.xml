<?xml version="1.0" encoding="utf-8"?>
<!--
  Minimal guaranteed-to-render fallback, shown only when a widget's full render
  throws. Deliberately trivial — a background, one brand line and one message,
  no weights, no images — so it can inflate on every widget host even when
  everything else fails. Tapping it opens the app.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp">

    <TextView
        android:id="@+id/fallback_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_title"
        android:textColor="@color/widget_text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/fallback_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_fallback_message"
        android:textColor="@color/widget_text_secondary"
        android:textSize="10sp" />

</LinearLayout>
