<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Baseline permissions for device inspection -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Fine location is required on modern Android to read Wi-Fi SSID / BSSID / frequency -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Deliberately NO READ_PHONE_STATE: the cellular section only reads public
         carrier/SIM fields (operator names, country ISOs, SIM state) that need no
         runtime permission, and the app never reads device identifiers. -->
    <!-- In-app updater: download a release APK and hand it to the package installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Query all packages for installed apps section -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Queries for Shizuku package visibility on Android 11+ -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <intent>
            <action android:name="rikka.shizuku.intent.action.REQUEST_BINDER" />
        </intent>
    </queries>

    <application
        android:name=".DevCheckApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DevCheckPlus">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DevCheckPlus">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Widget family — 7 widgets: Metrics, Compact, Battery, Device
             Overview, Performance, Minimal and Network. Every receiver here is
             matched 1:1 by an appwidget-provider metadata XML in res/xml and a
             provider class in widget/MetricsWidgetProvider.kt (enforced by
             WidgetConsistencyTest). -->
        <receiver android:name=".widget.MetricsWidgetProvider" android:exported="false" android:label="@string/widget_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info" />
        </receiver>
        <receiver android:name=".widget.CompactWidgetProvider" android:exported="false" android:label="@string/widget_compact_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_compact_info" />
        </receiver>
        <receiver android:name=".widget.BatteryWidgetProvider" android:exported="false" android:label="@string/widget_battery_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_battery_info" />
        </receiver>
        <receiver android:name=".widget.DeviceOverviewWidgetProvider" android:exported="false" android:label="@string/widget_device_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_device_info" />
        </receiver>
        <receiver android:name=".widget.PerformanceWidgetProvider" android:exported="false" android:label="@string/widget_performance_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_performance_info" />
        </receiver>
        <receiver android:name=".widget.MinimalWidgetProvider" android:exported="false" android:label="@string/widget_minimal_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_minimal_info" />
        </receiver>
        <receiver android:name=".widget.NetworkWidgetProvider" android:exported="false" android:label="@string/widget_network_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_network_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>
</manifest>
